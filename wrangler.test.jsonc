{
  "name": "kyami-ai-tests",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "KyamiRateLimiter"
      }
    ]
  },
  "exports": {
    "KyamiRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
